<Project>
  <!-- Shared metadata for every Glidecast project. Bump Version for releases. -->
  <PropertyGroup>
    <Version>1.2.2</Version>
    <Product>Glidecast</Product>
    <Company>Glidecast</Company>
    <Authors>Swarnim Bandekar and contributors</Authors>
    <Copyright>Copyright (c) 2026 Swarnim Bandekar and Glidecast contributors</Copyright>
    <Description>Glidecast: free, open-source auto-zoom screen recorder for Windows.</Description>
    <RepositoryUrl>https://github.com/swarnimbandekar/glidecast</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
