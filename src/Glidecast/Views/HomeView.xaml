<UserControl x:Class="Glidecast.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- New recording -->
        <ScrollViewer x:Name="HeroScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="600" Margin="48,64,48,40" HorizontalAlignment="Center">
                <TextBlock Text="New recording" Style="{StaticResource Title}" FontSize="26" />
                <TextBlock Style="{StaticResource Hint}" FontSize="13.5" LineHeight="21" Margin="0,8,0,0" MaxWidth="520" HorizontalAlignment="Left"
                           Text="Pick what to capture. Glidecast adds zooms on your clicks, a smooth cursor and a background, so the video is ready to share." />

                <TextBlock Text="Source" Style="{StaticResource SectionLabel}" Margin="0,32,0,10" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="FullScreenCard" Style="{StaticResource Card}" GroupName="mode" IsChecked="True" Margin="0,0,6,0">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Panel3}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17" />
                            </Border>
                            <TextBlock Text="Full screen" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3" />
                            <TextBlock Text="Your whole main display" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RegionCard" Style="{StaticResource Card}" GroupName="mode" Margin="6,0,0,0">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Panel3}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" FontSize="17" />
                            </Border>
                            <TextBlock Text="Custom area" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3" />
                            <TextBlock Text="Drag out the part you want" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <Border Margin="0,12,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Fps30" Content="30 fps" Style="{StaticResource Segment}" GroupName="fps" IsChecked="True" />
                                <RadioButton x:Name="Fps60" Content="60 fps" Style="{StaticResource Segment}" GroupName="fps" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Frame rate" FontWeight="Medium" />
                            <TextBlock Text="60 fps is smoother but makes larger files." Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button x:Name="RecordButton" AutomationProperties.Name="Start recording" Style="{StaticResource RecordButton}"
                            Padding="20,10" FontSize="14" Click="Record_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Start recording" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button Margin="10,0,0,0" Padding="14,10" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Open project" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0,0,0" Padding="12,10" Style="{StaticResource GhostButton}" Click="Demo_Click" Content="Try a demo" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="Recording starts after a 3-second countdown. The Stop toolbar is never captured." />
                <TextBlock x:Name="Status" Style="{StaticResource Hint}" Foreground="{StaticResource AccentText}" Margin="0,10,0,0" />

                <Border x:Name="RecoveredBanner" Visibility="Collapsed" Margin="0,20,0,0" Padding="12,10" CornerRadius="8"
                        Background="#143DD68C" BorderBrush="#403DD68C" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource Success}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock x:Name="RecoveredText" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Rectangle Style="{StaticResource Divider}" Margin="0,40,0,16" />
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock x:Name="SaveFolder" Style="{StaticResource Hint}" Foreground="{StaticResource Muted}" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Recent projects -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="24,24,24,12">
                    <Border x:Name="RecentCountTag" DockPanel.Dock="Right" Background="{StaticResource Panel3}" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock x:Name="RecentCount" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Subtext}" Typography.NumeralAlignment="Tabular" />
                    </Border>
                    <TextBlock Text="Recent projects" Style="{StaticResource Title}" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="NoRecent" DockPanel.Dock="Top" Margin="24,56,24,0">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="18" Foreground="{StaticResource Muted}" />
                    </Border>
                    <TextBlock Text="No recordings yet" HorizontalAlignment="Center" Margin="0,14,0,4" FontWeight="SemiBold" />
                    <TextBlock Text="Projects you record or open show up here." Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0" Padding="12,0,12,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Recent_Open">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112" Height="63" CornerRadius="6" Background="{StaticResource Panel3}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <Grid>
                                        <Border CornerRadius="5">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border Background="#CC000000" CornerRadius="4" Padding="5,1" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Length}" FontSize="10.5" FontWeight="Medium" Foreground="White" Typography.NumeralAlignment="Tabular" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
