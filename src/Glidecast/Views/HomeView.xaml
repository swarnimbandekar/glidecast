<UserControl x:Class="Glidecast.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Ambient glow behind the hero. -->
        <Ellipse Width="900" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-320,0,0" Opacity="0.35" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7C5CFF" Offset="0" />
                    <GradientStop Color="#007C5CFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="56,40,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="HeroScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="20" Padding="12,5" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="#B9A8FF" />
                            <TextBlock Text="Auto-zoom screen recorder" Foreground="#C9BCFF" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Title}" FontSize="38" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="46">
                        <Run Text="Record once." />
                        <LineBreak />
                        <Run Text="Ship a polished demo." Foreground="#A996FF" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}" FontSize="14" LineHeight="22" Margin="0,12,0,30" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Glidecast follows your clicks with smooth camera moves, renders a crisp cursor, and frames your screen on a beautiful background — automatically." />

                    <TextBlock Text="WHAT TO RECORD" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="FullScreenCard" Style="{StaticResource Card}" GroupName="mode" IsChecked="True" Margin="0,0,7,0">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="20" Foreground="#B9A8FF" />
                                </Border>
                                <TextBlock Text="Full screen" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock Text="Capture your whole main display." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RegionCard" Style="{StaticResource Card}" GroupName="mode" Margin="7,0,0,0">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" FontSize="20" Foreground="#B9A8FF" />
                                </Border>
                                <TextBlock Text="Custom area" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock Text="Drag out exactly the part you want." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <TextBlock Text="Frame rate" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Fps30" Content="30 fps" Style="{StaticResource Segment}" GroupName="fps" IsChecked="True" />
                                <RadioButton x:Name="Fps60" Content="60 fps" Style="{StaticResource Segment}" GroupName="fps" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Button x:Name="RecordButton" AutomationProperties.Name="Start recording" Style="{StaticResource RecordButton}"
                                Padding="28,14" FontSize="15" Click="Record_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" Margin="0,0,10,0">
                                    <Ellipse Stroke="White" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7" Fill="White" />
                                </Grid>
                                <TextBlock Text="Start recording" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Margin="12,0,0,0" Padding="18,14" Click="Open_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,9,0" />
                                <TextBlock Text="Open project" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0" Padding="16,14" Style="{StaticResource GhostButton}" Click="Demo_Click" Content="Try a demo" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="3-second countdown, then a small toolbar shows the timer and Stop. The toolbar never appears in your video." />
                    <TextBlock x:Name="Status" Style="{StaticResource Hint}" Foreground="#C9BCFF" Margin="0,10,0,0" />

                    <WrapPanel Margin="0,22,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Panel}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="16" />
                                <Setter Property="Padding" Value="11,6" />
                                <Setter Property="Margin" Value="0,0,8,8" />
                            </Style>
                        </WrapPanel.Resources>
                        <Border><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="12" Foreground="#A996FF" /><TextBlock Text="Auto zoom on clicks" FontSize="12" Margin="7,0,0,0" Foreground="{StaticResource Subtext}" /></StackPanel></Border>
                        <Border><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" FontSize="12" Foreground="#A996FF" /><TextBlock Text="Silky cursor" FontSize="12" Margin="7,0,0,0" Foreground="{StaticResource Subtext}" /></StackPanel></Border>
                        <Border><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="12" Foreground="#A996FF" /><TextBlock Text="Keystroke overlay" FontSize="12" Margin="7,0,0,0" Foreground="{StaticResource Subtext}" /></StackPanel></Border>
                        <Border><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="12" Foreground="#A996FF" /><TextBlock Text="Up to 4K / 60 fps export" FontSize="12" Margin="7,0,0,0" Foreground="{StaticResource Subtext}" /></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock x:Name="SaveFolder" Style="{StaticResource Hint}" Margin="0,14,0,0" Opacity="0.8" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="18" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,8,12">
                        <TextBlock Text="Recent projects" FontWeight="SemiBold" FontSize="15" Style="{StaticResource Title}" />
                        <TextBlock x:Name="RecentCount" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="NoRecent" DockPanel.Dock="Top" Margin="8,40,8,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="34" Foreground="#3A3F4B" />
                        <TextBlock Text="No recordings yet" HorizontalAlignment="Center" Margin="0,14,0,4" FontWeight="SemiBold" />
                        <TextBlock Text="Your projects will show up here." Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Recent_Open">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="128" Height="72" CornerRadius="9" Background="{StaticResource Panel3}" ClipToBounds="True">
                                        <Grid>
                                            <Border CornerRadius="9">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border Background="#B0000000" CornerRadius="5" Padding="5,1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Length}" FontSize="10.5" Foreground="White" FontFamily="{StaticResource MonoFont}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,4,4,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
