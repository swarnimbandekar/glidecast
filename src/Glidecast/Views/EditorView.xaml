<UserControl x:Class="Glidecast.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Glidecast.App.Controls"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Moved into the window title bar at runtime. -->
        <Grid x:Name="TitleBar" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="1" Height="18" Fill="{StaticResource BorderStrong}" Margin="0,0,8,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" Click="Home_Click" ToolTip="Back to home" />
                <TextBlock x:Name="ProjectName" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="6,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                <TextBlock x:Name="SourceInfo" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse x:Name="SaveDot" Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="SaveState" Text="Saved" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button AutomationProperties.Name="Export" Style="{StaticResource PrimaryButton}" Padding="14,0" Height="30" Click="Export_Click" ToolTip="Export video (Ctrl+E)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                        <TextBlock Text="Export" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="Body">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Stage -->
            <Grid Margin="32,28,32,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="StageFrame" CornerRadius="8" Background="#0A0A0B" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource SoftShadow}" ClipToBounds="True">
                    <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="Preview_Click" />
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeNow" FontSize="13" FontWeight="Medium" Typography.NumeralAlignment="Tabular" Text="00:00.0" />
                        <TextBlock x:Name="TimeTotal" FontSize="13" Foreground="{StaticResource Muted}" Typography.NumeralAlignment="Tabular" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Back5_Click" ToolTip="Back 5 s (Shift+←)" Width="36" Height="36" />
                        <Button x:Name="PlayButton" AutomationProperties.Name="Play" Click="Play_Click" Width="40" Height="40" Margin="12,0" Padding="0"
                                Style="{StaticResource PrimaryButton}" ToolTip="Play / Pause (Space)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="e" Fill="{StaticResource Text}" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="e" Property="Fill" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="e" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Foreground="{StaticResource Bg}" Margin="2,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Fwd5_Click" ToolTip="Forward 5 s (Shift+→)" Width="36" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8,4" ToolTip="Current zoom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="12" Foreground="{StaticResource Subtext}" />
                                <TextBlock x:Name="ZoomNow" FontSize="12" FontWeight="Medium" Typography.NumeralAlignment="Tabular" Margin="6,0,0,0" Text="1.0×" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Timeline -->
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,10,16,6" LastChildFill="False">
                        <TextBlock Text="Timeline" Style="{StaticResource Title}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="ZoomStats" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   Text="Space play · ←/→ step · Del delete · double-click lane to add" />
                        <Button DockPanel.Dock="Right" Padding="10,0" MinHeight="28" Height="28" Margin="0,0,16,0" Click="AddZoom_Click" ToolTip="Add a zoom at the playhead (Z)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,7,0" />
                                <TextBlock Text="Add zoom" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <c:TimelineControl x:Name="Timeline" Margin="0,0,0,6" />
                </DockPanel>
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="72" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Background="{StaticResource Bg}" Padding="0,10">
                        <StackPanel>
                            <RadioButton x:Name="TabBg" Content="Backdrop" Tag="&#xEB9F;" ToolTip="Background" Style="{StaticResource InspectorTab}" GroupName="tab" IsChecked="True" Checked="Tab_Changed" />
                            <RadioButton x:Name="TabFrame" Content="Frame" Tag="&#xE7F4;" Style="{StaticResource InspectorTab}" GroupName="tab" Checked="Tab_Changed" />
                            <RadioButton x:Name="TabCursor" Content="Cursor" Tag="&#xE7C9;" Style="{StaticResource InspectorTab}" GroupName="tab" Checked="Tab_Changed" />
                            <RadioButton x:Name="TabZoom" Content="Zoom" Tag="&#xE8A3;" Style="{StaticResource InspectorTab}" GroupName="tab" Checked="Tab_Changed" />
                            <RadioButton x:Name="TabNotes" Content="Annotate" Tag="&#xE70F;" Style="{StaticResource InspectorTab}" GroupName="tab" Checked="Tab_Changed" />
                            <RadioButton x:Name="TabLooks" Content="Looks" Tag="&#xE790;" Style="{StaticResource InspectorTab}" GroupName="tab" Checked="Tab_Changed" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,0" Height="48">
                        <TextBlock x:Name="InspectorTitle" Text="Background" Style="{StaticResource Title}" FontSize="14" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,12,24">
                        <Grid>
                            <!-- BACKGROUND -->
                            <StackPanel x:Name="BgPanel">
                                <TextBlock Text="Type" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="BgGradient" Content="Gradient" Style="{StaticResource Segment}" GroupName="bg" Checked="BgKind_Changed" />
                                        <RadioButton x:Name="BgSolid" Content="Solid" Style="{StaticResource Segment}" GroupName="bg" Checked="BgKind_Changed" />
                                        <RadioButton x:Name="BgImage" Content="Wallpaper" Style="{StaticResource Segment}" GroupName="bg" Checked="BgKind_Changed" />
                                    </UniformGrid>
                                </Border>
                                <StackPanel x:Name="GradientPanel">
                                    <TextBlock Text="Presets" Style="{StaticResource SectionLabel}" />
                                    <WrapPanel x:Name="GradientSwatches" />
                                </StackPanel>
                                <StackPanel x:Name="SolidPanel">
                                    <TextBlock Text="Color" Style="{StaticResource SectionLabel}" />
                                    <WrapPanel x:Name="SolidSwatches" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Border x:Name="SolidPreview" Width="34" Height="34" CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,10,0" />
                                        <TextBox x:Name="SolidHex" TextChanged="SolidHex_Changed" FontFamily="{StaticResource MonoFont}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel x:Name="ImagePanel">
                                    <TextBlock Text="Wallpaper" Style="{StaticResource SectionLabel}" />
                                    <Border CornerRadius="10" Height="150" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Border x:Name="WallPreview" CornerRadius="10" />
                                            <TextBlock x:Name="ImageName" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Button HorizontalAlignment="Left" Margin="0,10,0,0" Click="ChooseImage_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Choose image…" />
                                        </StackPanel>
                                    </Button>
                                    <DockPanel Style="{StaticResource Row}" Margin="0,14,0,0"><TextBlock x:Name="BlurVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Blur" /></DockPanel>
                                    <Slider x:Name="BlurSlider" Minimum="0" Maximum="60" ValueChanged="Style_Changed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- FRAME -->
                            <StackPanel x:Name="FramePanel" Visibility="Collapsed">
                                <TextBlock Text="Canvas" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="AspSource" Content="Source" Tag="Source" Style="{StaticResource Segment}" GroupName="asp" Checked="Aspect_Checked" />
                                        <RadioButton x:Name="AspWide" Content="16:9" Tag="Wide" Style="{StaticResource Segment}" GroupName="asp" Checked="Aspect_Checked" />
                                        <RadioButton x:Name="AspVertical" Content="9:16" Tag="Vertical" Style="{StaticResource Segment}" GroupName="asp" Checked="Aspect_Checked" />
                                        <RadioButton x:Name="AspSquare" Content="1:1" Tag="Square" Style="{StaticResource Segment}" GroupName="asp" Checked="Aspect_Checked" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="9:16 and 1:1 reframe the recording: the camera pans to keep the action in the frame." />

                                <TextBlock Text="Layout" Style="{StaticResource SectionLabel}" />
                                <DockPanel><TextBlock x:Name="PaddingVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Padding" /></DockPanel>
                                <Slider x:Name="PaddingSlider" Minimum="0" Maximum="0.2" ValueChanged="Style_Changed" />
                                <DockPanel Style="{StaticResource Row}"><TextBlock x:Name="RadiusVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Corner radius" /></DockPanel>
                                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="60" ValueChanged="Style_Changed" />
                                <DockPanel Style="{StaticResource Row}"><TextBlock x:Name="ShadowVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Shadow" /></DockPanel>
                                <Slider x:Name="ShadowSlider" Minimum="0" Maximum="100" ValueChanged="Style_Changed" />

                                <TextBlock Text="Effects" Style="{StaticResource SectionLabel}" />
                                <CheckBox x:Name="MotionBlurToggle" Style="{StaticResource Switch}" Click="Style_Changed">
                                    <StackPanel><TextBlock Text="Motion blur" /><TextBlock Text="Softens the screen during fast camera moves." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="KeysToggle" Style="{StaticResource Switch}" Click="Style_Changed" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Keystrokes" /><TextBlock Text="Show pressed keys as keycaps." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>

                                <TextBlock Text="Brand logo" Style="{StaticResource SectionLabel}" />
                                <DockPanel>
                                    <Border x:Name="LogoPreview" Width="56" Height="40" CornerRadius="8" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,10,0" />
                                    <Button x:Name="LogoRemove" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="LogoRemove_Click" ToolTip="Remove logo" Width="30" Height="30" />
                                    <Button HorizontalAlignment="Left" Click="ChooseLogo_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock x:Name="LogoButtonText" Text="Choose logo…" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <StackPanel x:Name="LogoOptions">
                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                                        <UniformGrid Columns="4">
                                            <RadioButton x:Name="LogoTL" Content="↖" Tag="TopLeft" Style="{StaticResource Segment}" GroupName="logo" Checked="LogoCorner_Checked" ToolTip="Top left" />
                                            <RadioButton x:Name="LogoTR" Content="↗" Tag="TopRight" Style="{StaticResource Segment}" GroupName="logo" Checked="LogoCorner_Checked" ToolTip="Top right" />
                                            <RadioButton x:Name="LogoBL" Content="↙" Tag="BottomLeft" Style="{StaticResource Segment}" GroupName="logo" Checked="LogoCorner_Checked" ToolTip="Bottom left" />
                                            <RadioButton x:Name="LogoBR" Content="↘" Tag="BottomRight" Style="{StaticResource Segment}" GroupName="logo" Checked="LogoCorner_Checked" ToolTip="Bottom right" />
                                        </UniformGrid>
                                    </Border>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock x:Name="LogoSizeVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Size" /></DockPanel>
                                    <Slider x:Name="LogoSizeSlider" Minimum="0.04" Maximum="0.3" ValueChanged="Style_Changed" />
                                    <DockPanel Style="{StaticResource Row}"><TextBlock x:Name="LogoOpacityVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Opacity" /></DockPanel>
                                    <Slider x:Name="LogoOpacitySlider" Minimum="0.1" Maximum="1" ValueChanged="Style_Changed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- CURSOR -->
                            <StackPanel x:Name="CursorPanel" Visibility="Collapsed">
                                <CheckBox x:Name="CursorToggle" Style="{StaticResource Switch}" Click="Style_Changed" Margin="0,18,0,0">
                                    <TextBlock Text="Show cursor" FontWeight="SemiBold" />
                                </CheckBox>
                                <TextBlock Text="Style" Style="{StaticResource SectionLabel}" />
                                <WrapPanel x:Name="CursorStyles" />
                                <TextBlock Text="Size" Style="{StaticResource SectionLabel}" Margin="0,12,0,10" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="SizeS" Content="S" Tag="1.0" Style="{StaticResource Segment}" GroupName="csize" Checked="SizePreset_Checked" />
                                        <RadioButton x:Name="SizeM" Content="M" Tag="1.6" Style="{StaticResource Segment}" GroupName="csize" Checked="SizePreset_Checked" />
                                        <RadioButton x:Name="SizeL" Content="L" Tag="2.3" Style="{StaticResource Segment}" GroupName="csize" Checked="SizePreset_Checked" />
                                        <RadioButton x:Name="SizeXL" Content="XL" Tag="3.2" Style="{StaticResource Segment}" GroupName="csize" Checked="SizePreset_Checked" />
                                    </UniformGrid>
                                </Border>
                                <DockPanel Style="{StaticResource Row}"><TextBlock x:Name="CursorVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Fine size" Foreground="{StaticResource Subtext}" /></DockPanel>
                                <Slider x:Name="CursorSlider" Minimum="0.6" Maximum="4" ValueChanged="Style_Changed" />
                                <DockPanel Style="{StaticResource Row}"><TextBlock x:Name="SmoothVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Movement smoothing" /></DockPanel>
                                <Slider x:Name="SmoothSlider" Minimum="0" Maximum="1" ValueChanged="Style_Changed" />

                                <TextBlock Text="Click effect" Style="{StaticResource SectionLabel}" />
                                <WrapPanel x:Name="ClickEffects" />
                                <TextBlock Text="Accent" Style="{StaticResource SectionLabel}" Margin="0,12,0,10" />
                                <WrapPanel x:Name="AccentSwatches" />
                                <CheckBox x:Name="IdleToggle" Style="{StaticResource Switch}" Click="Style_Changed" Margin="0,8,0,0">
                                    <StackPanel><TextBlock Text="Hide when idle" /><TextBlock Text="Fade the cursor out after 2.5 s without movement." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="TrailToggle" Style="{StaticResource Switch}" Click="Style_Changed" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Motion trail" /><TextBlock Text="A short streak in your accent color behind fast moves." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- ZOOM -->
                            <StackPanel x:Name="ZoomPanel" Visibility="Collapsed">
                                <Border x:Name="SelectedCard" Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="DeleteSel_Click" ToolTip="Delete zoom (Del)" Foreground="{StaticResource Danger}" Width="30" Height="30" />
                                            <TextBlock Text="Selected zoom" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="SelTimes" Style="{StaticResource Hint}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,8" />
                                        <DockPanel><TextBlock x:Name="SelScaleVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Zoom level" /></DockPanel>
                                        <Slider x:Name="SelScale" Minimum="1.1" Maximum="4" ValueChanged="SelScale_Changed" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,10" Text="Click anywhere on the preview to aim this zoom." />
                                        <Button HorizontalAlignment="Left" Padding="10,5" Click="JumpSel_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0" />
                                                <TextBlock Text="Preview from start" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="NoSelection" Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="No zoom selected" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Click a block on the timeline to edit it. Drag it to move, drag its edges to resize, double-click the lane to add one." />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Camera motion" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="SpeedGentle" Content="Gentle" Style="{StaticResource Segment}" GroupName="speed" Checked="Speed_Checked" />
                                        <RadioButton x:Name="SpeedSmooth" Content="Smooth" Style="{StaticResource Segment}" GroupName="speed" Checked="Speed_Checked" />
                                        <RadioButton x:Name="SpeedSnappy" Content="Snappy" Style="{StaticResource Segment}" GroupName="speed" Checked="Speed_Checked" />
                                    </UniformGrid>
                                </Border>
                                <CheckBox x:Name="FollowToggle" Style="{StaticResource Switch}" Click="Follow_Click" Margin="0,14,0,0">
                                    <StackPanel><TextBlock Text="Follow cursor" /><TextBlock Text="While zoomed, pan to keep the cursor in view." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>

                                <TextBlock Text="Preset" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="PresetSubtle" Content="Subtle" Tag="Subtle" Style="{StaticResource Segment}" Padding="2,5" GroupName="preset" Click="Preset_Click" />
                                        <RadioButton x:Name="PresetBalanced" Content="Balanced" Tag="Balanced" Style="{StaticResource Segment}" Padding="2,5" GroupName="preset" Click="Preset_Click" />
                                        <RadioButton x:Name="PresetDramatic" Content="Dramatic" Tag="Dramatic" Style="{StaticResource Segment}" Padding="2,5" GroupName="preset" Click="Preset_Click" />
                                        <RadioButton x:Name="PresetTutorial" Content="Tutorial" Tag="Tutorial" Style="{StaticResource Segment}" Padding="2,5" GroupName="preset" Click="Preset_Click" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock x:Name="PresetHint" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <CheckBox x:Name="SmartToggle" Style="{StaticResource Switch}" Click="ZoomSwitch_Click" Margin="0,14,0,0">
                                    <StackPanel><TextBlock Text="Smart framing" /><TextBlock x:Name="SmartHint" Text="Fit the zoom to the clicked button, menu or panel." Style="{StaticResource Hint}" TextWrapping="Wrap" /></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="TypingToggle" Style="{StaticResource Switch}" Click="ZoomSwitch_Click" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Follow typing" /><TextBlock x:Name="TypingHint" Text="Zoom on the text caret and follow the words as you type." Style="{StaticResource Hint}" TextWrapping="Wrap" /></StackPanel>
                                </CheckBox>

                                <TextBlock Text="Auto zoom" Style="{StaticResource SectionLabel}" />
                                <DockPanel><TextBlock x:Name="AutoScaleVal" Style="{StaticResource Value}" DockPanel.Dock="Right" /><TextBlock Text="Default zoom level" /></DockPanel>
                                <Slider x:Name="AutoScale" Minimum="1.2" Maximum="3.5" ValueChanged="AutoScale_Changed" />
                                <Button HorizontalAlignment="Left" Margin="0,12,0,0" Click="Regenerate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource AccentText}" />
                                        <TextBlock Text="Regenerate from clicks" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Rebuilds the zoom lane from your clicks and typing. Replaces manual edits." />
                            </StackPanel>

                            <!-- ANNOTATE -->
                            <StackPanel x:Name="NotesPanel" Visibility="Collapsed">
                                <TextBlock Text="Auto walkthrough" Style="{StaticResource SectionLabel}" />
                                <CheckBox x:Name="AutoSteps" Style="{StaticResource Switch}" IsChecked="True">
                                    <StackPanel><TextBlock Text="Step numbers" /><TextBlock Text="A numbered badge on every click." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="AutoBoxes" Style="{StaticResource Switch}" IsChecked="True" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Highlight boxes" /><TextBlock Text="Outline the control that was clicked." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="AutoCaptions" Style="{StaticResource Switch}" IsChecked="True" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Captions" /><TextBlock Text="Click “Save”, named from the app's own labels." Style="{StaticResource Hint}" /></StackPanel>
                                </CheckBox>
                                <Button HorizontalAlignment="Left" Margin="0,14,0,0" Click="GenerateNotes_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource AccentText}" />
                                        <TextBlock Text="Generate from clicks" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="NotesInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="Add at playhead" Style="{StaticResource SectionLabel}" />
                                <WrapPanel>
                                    <Button Content="Step" Tag="Step" Click="AddNote_Click" Margin="0,0,6,6" Padding="10,5" />
                                    <Button Content="Highlight" Tag="Highlight" Click="AddNote_Click" Margin="0,0,6,6" Padding="10,5" />
                                    <Button Content="Spotlight" Tag="Spotlight" Click="AddNote_Click" Margin="0,0,6,6" Padding="10,5" />
                                    <Button Content="Arrow" Tag="Arrow" Click="AddNote_Click" Margin="0,0,6,6" Padding="10,5" />
                                    <Button Content="Callout" Tag="Callout" Click="AddNote_Click" Margin="0,0,6,6" Padding="10,5" />
                                </WrapPanel>

                                <Border x:Name="NoteCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="DeleteNote_Click" ToolTip="Delete (Del)" Foreground="{StaticResource Danger}" Width="30" Height="30" />
                                            <TextBlock x:Name="NoteTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="NoteTimes" Style="{StaticResource Hint}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,8" />
                                        <TextBox x:Name="NoteText" TextChanged="NoteText_Changed" Margin="0,0,0,8" />
                                        <StackPanel x:Name="NoteNumberRow" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Number" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Content="−" Width="30" Click="NoteNumber_Click" Tag="-1" />
                                            <TextBlock x:Name="NoteNumber" Width="34" TextAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <Button Content="+" Width="30" Click="NoteNumber_Click" Tag="1" />
                                        </StackPanel>
                                        <WrapPanel>
                                            <Button Content="Start here" Click="NoteStart_Click" Margin="0,0,6,6" Padding="10,5" ToolTip="Start at the playhead" />
                                            <Button Content="End here" Click="NoteEnd_Click" Margin="0,0,6,6" Padding="10,5" ToolTip="End at the playhead" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Click the preview to move it. Drag its bar on the Notes lane to retime it." />
                                    </StackPanel>
                                </Border>

                                <CheckBox x:Name="NotesToggle" Style="{StaticResource Switch}" Click="Style_Changed" Margin="0,16,0,0">
                                    <TextBlock Text="Show annotations" />
                                </CheckBox>
                            </StackPanel>

                            <!-- LOOKS -->
                            <StackPanel x:Name="LooksPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,20,0,14"
                                           Text="A look is your brand kit: background, frame, cursor, accent, logo and canvas. Apply one in a click, or make one the default for new recordings." />
                                <StackPanel x:Name="LookList" />
                                <Button HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveLook_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource AccentText}" />
                                        <TextBlock Text="Save current look…" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="LooksInfo" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
