<Window x:Class="Glidecast.App.Views.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Icon="/Glidecast;component/Assets/glidecast.ico"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" Title="Glidecast — Recording">
    <Border x:Name="Chrome" Background="#F215171C" CornerRadius="24" Padding="8" Margin="14"
            BorderBrush="#33FFFFFF" BorderThickness="1" MouseLeftButtonDown="Drag" Effect="{StaticResource SoftShadow}">
        <StackPanel Orientation="Horizontal">
            <Border Background="#26FF4D6A" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RecLabel" Text="GET READY" FontSize="11" FontWeight="Bold" Foreground="#FF8FA3" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Clock" Text="0:00" FontSize="18" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" MinWidth="58" Margin="14,0,4,0" />
            <TextBlock x:Name="Info" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,14,0" />
            <Rectangle Width="1" Height="22" Fill="{StaticResource Border}" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Discard_Click" ToolTip="Discard recording" Width="36" Height="36" />
            <Button x:Name="StopButton" AutomationProperties.Name="Stop recording" Click="Stop_Click" Margin="6,0,0,0" ToolTip="Stop and open the editor">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource RecordGradient}" CornerRadius="18" Padding="16,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.6" Color="#FF5A7A" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="10" Height="10" Fill="White" RadiusX="2.5" RadiusY="2.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Stop" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
