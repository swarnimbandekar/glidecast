<Window x:Class="Glidecast.App.Views.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Icon="/Glidecast;component/Assets/glidecast.ico"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" Title="Glidecast — Recording">
    <Border x:Name="Chrome" Background="#F51B1B1D" CornerRadius="12" Padding="6" Margin="16"
            BorderBrush="#26FFFFFF" BorderThickness="1" MouseLeftButtonDown="Drag" Effect="{StaticResource SoftShadow}">
        <StackPanel Orientation="Horizontal">
            <Border Background="#1FE5484D" CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RecLabel" Text="GET READY" FontSize="11" FontWeight="SemiBold" Foreground="#FF9592" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Clock" Text="0:00" FontSize="16" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" MinWidth="52" Margin="14,0,4,0" />
            <TextBlock x:Name="Info" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,10,0" />
            <ToggleButton x:Name="AnnotateLiveToggle" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center" Margin="0,0,6,0"
                          Click="AnnotateLive_Click" ToolTip="Toggle recording annotations &amp; live on-screen preview">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Panel3}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ic" Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="11" Foreground="{StaticResource Subtext}" Margin="0,0,5,0" />
                                <TextBlock x:Name="tx" Text="Annotate" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Subtext}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource AccentText}" />
                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Button x:Name="MarkButton" Style="{StaticResource GhostButton}" Padding="7,3" MinHeight="24" Margin="0,0,10,0" VerticalAlignment="Center"
                    Click="Mark_Click" ToolTip="Add a highlight box at the cursor right now (F9)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="11" Foreground="{StaticResource AccentText}" Margin="0,0,5,0" />
                    <TextBlock x:Name="MarkButtonText" Text="Mark (F9)" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Subtext}" />
                </StackPanel>
            </Button>
            <Rectangle Width="1" Height="20" Fill="{StaticResource BorderStrong}" Margin="0,0,6,0" />
            <Button x:Name="CancelButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Discard_Click" ToolTip="Discard recording" />
            <Button x:Name="StopButton" AutomationProperties.Name="Stop recording" Click="Stop_Click" Margin="6,0,0,0" ToolTip="Stop and open the editor">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Danger}" CornerRadius="7" Padding="14,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource DangerHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Fill="White" RadiusX="2" RadiusY="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Stop" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
