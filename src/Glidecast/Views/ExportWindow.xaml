<Window x:Class="Glidecast.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export video" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <StackPanel>
            <DockPanel Height="64" Margin="24,0,12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Click="Cancel_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                <Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource Panel3}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="13" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Export video" Style="{StaticResource Title}" FontSize="14" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Hint}" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>
            <Rectangle Height="1" Fill="{StaticResource Border}" />

            <StackPanel x:Name="Options" Margin="24,0,24,0">
                <TextBlock Text="Canvas" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel x:Name="AspectPanel" Orientation="Horizontal" />
                </Border>
                <TextBlock x:Name="AspectInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Resolution" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel x:Name="ResPanel" Orientation="Horizontal" />
                </Border>
                <TextBlock x:Name="ResInfo" Style="{StaticResource Hint}" Typography.NumeralAlignment="Tabular" Margin="0,8,0,0" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Frame rate" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Fps24" Content="24" Style="{StaticResource Segment}" GroupName="fps" />
                                <RadioButton x:Name="Fps30" Content="30" Style="{StaticResource Segment}" GroupName="fps" />
                                <RadioButton x:Name="Fps60" Content="60" Style="{StaticResource Segment}" GroupName="fps" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Quality" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="QDraft" Content="Draft" Style="{StaticResource Segment}" GroupName="q" AutomationProperties.Name="Draft (fast)" />
                                <RadioButton x:Name="QStandard" Content="Standard" Style="{StaticResource Segment}" GroupName="q" IsChecked="True" />
                                <RadioButton x:Name="QHigh" Content="High" Style="{StaticResource Segment}" GroupName="q" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Encoder" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="EncAuto" Content="Auto" Style="{StaticResource Segment}" GroupName="enc" IsChecked="True" />
                        <RadioButton x:Name="EncGpu" Content="GPU" Style="{StaticResource Segment}" GroupName="enc" IsEnabled="False" />
                        <RadioButton x:Name="EncCpu" Content="CPU" Style="{StaticResource Segment}" GroupName="enc" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="EncInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Text="Checking for GPU encoders…" />

                <TextBlock Text="Save to" Style="{StaticResource SectionLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Browse" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="OutPath" />
                </DockPanel>
            </StackPanel>

            <Border x:Name="ProgressPanel" Margin="24,24,24,0" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="ProgressPct" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock x:Name="ProgressTitle" Text="Rendering" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Rectangle Style="{StaticResource Divider}" Margin="0,24,0,0" />
            <DockPanel Margin="24,16,24,16" LastChildFill="False">
                <Button x:Name="OpenFolderButton" DockPanel.Dock="Left" Visibility="Collapsed" Click="ShowFolder_Click" Content="Show in folder" />
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Margin="8,0,0,0" Visibility="Collapsed" Click="PlayVideo_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Export MP4" Padding="18,0" Click="Export_Click" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource GhostButton}" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
