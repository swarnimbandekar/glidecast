<Window x:Class="Glidecast.App.Views.PrepareBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Icon="/Glidecast;component/Assets/glidecast.ico"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13" Title="Glidecast — Ready to record">
    <Window.Resources>
        <Style x:Key="Pick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="34" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </Window.Resources>
    <Border x:Name="Chrome" Background="#F51B1B1D" CornerRadius="12" Padding="8" Margin="16"
            BorderBrush="#26FFFFFF" BorderThickness="1" MouseLeftButtonDown="Drag" Effect="{StaticResource SoftShadow}">
        <StackPanel Orientation="Horizontal">
            <!-- What will be recorded -->
            <Border Background="{StaticResource Panel3}" CornerRadius="8" Padding="12,0" Height="34" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeIcon" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentText}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ModeText" FontWeight="Medium" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>
            <Rectangle Width="1" Height="22" Fill="{StaticResource BorderStrong}" Margin="10,0" />

            <!-- Inputs -->
            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="14" Foreground="{StaticResource Subtext}" Margin="2,0,8,0" ToolTip="Camera" />
            <ComboBox x:Name="CameraPick" Style="{StaticResource Pick}" SelectionChanged="Camera_Changed" ToolTip="Camera" />
            <StackPanel x:Name="ShapePanel" Orientation="Horizontal" Margin="6,0,0,0">
                <Border Style="{StaticResource SegmentHost}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ShapeCircle" Tag="Circle" Style="{StaticResource Segment}" GroupName="shape" Padding="8,4" Checked="Shape_Checked" ToolTip="Circle">
                            <Ellipse Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                        </RadioButton>
                        <RadioButton x:Name="ShapeSquare" Tag="Square" Style="{StaticResource Segment}" GroupName="shape" Padding="8,4" Checked="Shape_Checked" ToolTip="Rounded square">
                            <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                        </RadioButton>
                        <RadioButton x:Name="ShapeOval" Tag="Oval" Style="{StaticResource Segment}" GroupName="shape" Padding="8,4" Checked="Shape_Checked" ToolTip="Oval">
                            <Ellipse Width="17" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="14" Foreground="{StaticResource Subtext}" Margin="14,0,8,0" ToolTip="Microphone" />
            <Grid VerticalAlignment="Center">
                <ComboBox x:Name="MicPick" Style="{StaticResource Pick}" SelectionChanged="Mic_Changed" ToolTip="Microphone" />
                <Border x:Name="MicLevel" Height="2" CornerRadius="1" Background="{StaticResource Success}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,3" Width="0" IsHitTestVisible="False" />
            </Grid>

            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="14" Foreground="{StaticResource Subtext}" Margin="14,0,8,0" ToolTip="System sound" />
            <ComboBox x:Name="SpeakerPick" Style="{StaticResource Pick}" SelectionChanged="Speaker_Changed" ToolTip="System sound" />
            <Rectangle Width="1" Height="22" Fill="{StaticResource BorderStrong}" Margin="10,0" />

            <!-- Take settings -->
            <ToggleButton x:Name="SettingsToggle" Width="34" Height="34" ToolTip="Countdown, frame rate, annotations" Cursor="Hand" FocusVisualStyle="{x:Null}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14" Foreground="{StaticResource Subtext}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle}" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" Closed="Settings_Closed">
                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,8,0,0" Width="300">
                    <StackPanel>
                        <TextBlock Text="Countdown" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="Count0" Content="Off" Tag="0" Style="{StaticResource Segment}" GroupName="count" Checked="Setting_Changed" />
                                <RadioButton x:Name="Count3" Content="3 s" Tag="3" Style="{StaticResource Segment}" GroupName="count" Checked="Setting_Changed" />
                                <RadioButton x:Name="Count5" Content="5 s" Tag="5" Style="{StaticResource Segment}" GroupName="count" Checked="Setting_Changed" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Frame rate" Style="{StaticResource Hint}" Margin="0,12,0,6" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="Fps30" Content="30 fps" Style="{StaticResource Segment}" GroupName="fps" Checked="Setting_Changed" />
                                <RadioButton x:Name="Fps60" Content="60 fps" Style="{StaticResource Segment}" GroupName="fps" Checked="Setting_Changed" />
                            </UniformGrid>
                        </Border>
                        <CheckBox x:Name="AnnotateToggle" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="Setting_Changed">
                            <StackPanel>
                                <TextBlock Text="Annotate as I record" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Numbered steps, boxes and captions for every click. F9 highlights any moment." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </Popup>
            <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" Width="34" Height="34" Click="Teleprompter_Click" ToolTip="Teleprompter" Margin="2,0,0,0" />

            <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="12,0" Height="34" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button x:Name="StartButton" Style="{StaticResource RecordButton}" Padding="16,0" Height="34" Margin="6,0,0,0" Click="Start_Click" ToolTip="Start recording (Enter)">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="White" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="Start recording" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
